# Lead delivery (forms) — add to Vercel → Settings → Environment Variables
# Without RESEND_API_KEY, leads are written to local JSONL only (lost on Vercel).
RESEND_API_KEY=
# Optional: verified Resend sender. Defaults to onboarding@resend.dev (works for testing).
RESEND_FROM=
# Optional: lead recipient. Defaults to SITE.email (sales@<your-domain>).
RESEND_TO=

# Public site URL (used in metadata/sitemap base). Defaults to SITE.domain in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=


# Ops pipeline (Feishu) — lead ingestion into Bitable + group-bot card.
# Create app at https://open.feishu.cn/app, see docs/superpowers/plans/2026-08-13-ops-phase1.md Task 1.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_LEADS_TABLE_ID=
# Optional: group bot webhook. Without it, leads still land in Bitable (no card).
FEISHU_BOT_WEBHOOK=
FEISHU_NOTIFY_CHAT_ID=
